---
import BaseLayout from "../layouts/BaseLayout.astro";
import Headline from "../components/ui/Headline.astro";
import Button from "../components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

type CardItem = {
  icon: string;
  title: string;
  description: string;
};

type FlowItem = {
  number: string;
  title: string;
  description: string;
  accent?: boolean;
};

type WorkCard = {
  number: string;
  icon: string;
  title: string;
  description: string;
  tags: string[];
  tone: "blue" | "purple" | "pink" | "teal" | "amber" | "indigo";
};

type DeliverCard = {
  title: string;
  description: string;
  icon: string;
  tone: "blue" | "purple" | "green" | "amber";
  featured?: boolean;
  col2?: boolean;
  items?: string[];
};

const allPosts = await getCollection("blog");

const relatedPosts = allPosts
  .filter(
    (post) =>
      post.data &&
      post.data.pubDate &&
      post.data.category === "Plan de comunicación"
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const faqs = [
  {
    question: "¿Qué incluye un plan de comunicación?",
    answer:
      "Un plan de comunicación incluye diagnóstico de la situación actual, definición de objetivos, públicos, mensajes, canales y una estructura de trabajo para sostener la comunicación en el tiempo.",
  },
  {
    question: "¿Cuánto tiempo lleva hacer un plan de comunicación?",
    answer:
      "Depende del tamaño de la organización, pero normalmente el proceso incluye una etapa de diagnóstico, una fase de orden estratégico y la entrega del documento final.",
  },
  {
    question: "¿Este servicio incluye diseño o producción de contenido?",
    answer:
      "No. Este servicio se enfoca en la estrategia y organización de la comunicación. La producción de piezas se trabaja dentro del servicio de Producción Multimedia.",
  },
  {
    question: "¿Sirve para profesionales o solo para empresas?",
    answer:
      "Sirve para empresas, instituciones y también profesionales que quieren ordenar su comunicación y tomar decisiones con más criterio.",
  },
];

const metadata = {
  title: "Plan de comunicación",
  description:
    "Ordenamos tu comunicación para que deje de depender de la improvisación. Diagnóstico, estrategia, estructura operativa y hoja de ruta.",
  ignoreTitleTemplate: true,
};

const problemCards: CardItem[] = [
  {
    icon: "lucide:user-round",
    title: "Todo pasa por una sola persona",
    description:
      "Sin distribución de roles, la comunicación queda atada a la disponibilidad de una persona.",
  },
  {
    icon: "lucide:calendar-clock",
    title: "Las publicaciones dependen del tiempo disponible",
    description:
      "Si no hay estructura, la comunicación cede frente a otras urgencias del día a día.",
  },
  {
    icon: "lucide:git-compare-arrows",
    title: "Cada área comunica cosas distintas",
    description:
      "Sin coordinación, los mensajes se superponen o contradicen entre áreas.",
  },
  {
    icon: "lucide:list-todo",
    title: "No está claro qué conviene decir primero",
    description:
      "Sin prioridades definidas, todo parece igual de urgente y nada avanza bien.",
  },
  {
    icon: "lucide:repeat-2",
    title: "Se repiten ideas o se improvisan temas",
    description:
      "La falta de planificación lleva a ciclos de repetición o a improvisar en el último momento.",
  },
  {
    icon: "lucide:chart-no-axes-column-decreasing",
    title: "Mucho esfuerzo, poca continuidad",
    description:
      "El equipo trabaja, pero sin una lógica clara los resultados no se acumulan.",
  },
];

const whatItems = [
  "Comunicar con mayor claridad",
  "Tomar decisiones con más criterio",
  "Sostener el trabajo en el tiempo",
  "Evitar la improvisación permanente",
];

const flowItems: FlowItem[] = [
  {
    number: "1",
    title: "Diagnóstico de situación actual",
    description: "Entendemos cómo está comunicando hoy la organización.",
  },
  {
    number: "2",
    title: "Orden estratégico",
    description: "Definimos prioridades, públicos, mensajes y canales.",
  },
  {
    number: "3",
    title: "Estructura operativa",
    description: "Organizamos roles, responsables y lógica de trabajo.",
  },
  {
    number: "4",
    title: "Plan entregado y presentado",
    description: "El equipo puede comprenderlo y empezar a aplicarlo.",
    accent: true,
  },
];

const workCards: WorkCard[] = [
  {
    number: "01",
    icon: "lucide:search",
    title: "Diagnóstico actual",
    description:
      "Analizamos canales, tipos de contenido, mensajes principales y coherencia entre piezas y áreas.",
    tags: ["Canales", "Contenidos", "Equipo"],
    tone: "blue",
  },
  {
    number: "02",
    icon: "lucide:target",
    title: "Objetivos y prioridades",
    description:
      "Definimos qué se quiere lograr y qué conviene priorizar. No todo se puede hacer al mismo tiempo.",
    tags: ["Focos", "Metas"],
    tone: "purple",
  },
  {
    number: "03",
    icon: "lucide:messages-square",
    title: "Públicos y mensajes clave",
    description:
      "Identificamos a quién se comunica y qué es importante decir, con criterios para adaptar el mensaje.",
    tags: ["Audiencias", "Mensajes", "Contexto"],
    tone: "pink",
  },
  {
    number: "04",
    icon: "lucide:radio",
    title: "Canales y formatos",
    description:
      "Cada canal tiene un rol claro: redes sociales, sitio web, campañas y comunicación institucional.",
    tags: ["RRSS", "Web", "Institucional"],
    tone: "teal",
  },
  {
    number: "05",
    icon: "lucide:pen-tool",
    title: "Tono y criterios",
    description:
      "Lineamientos de estilo, redacción y forma de presentar la información para mantener coherencia.",
    tags: ["Voz", "Estilo", "Coherencia"],
    tone: "amber",
  },
  {
    number: "06",
    icon: "lucide:map",
    title: "Hoja de ruta",
    description:
      "Base de planificación con prioridades por etapa, ejes de contenido y lógica de continuidad.",
    tags: ["Etapas", "Ejes", "Continuidad"],
    tone: "indigo",
  },
];

const processSteps: FlowItem[] = [
  {
    number: "01",
    title: "Diagnóstico",
    description:
      "Reunión inicial para entender el contexto, objetivos y dificultades actuales. Revisamos canales y materiales existentes.",
  },
  {
    number: "02",
    title: "Orden estratégico",
    description:
      "Organizamos la base del plan: prioridades, públicos, mensajes, canales y criterios que orienten la comunicación.",
  },
  {
    number: "03",
    title: "Estructura operativa",
    description:
      "Organizamos roles, responsables y una lógica de trabajo que permita sostener el plan en el tiempo.",
  },
  {
    number: "04",
    title: "Entrega del plan",
    description:
      "Presentamos el plan final en videollamada. El equipo puede comprenderlo fácilmente y empezar a aplicarlo.",
    accent: true,
  },
];

const deliverCards: DeliverCard[] = [
  {
    title: "Documento estratégico principal",
    description:
      "El núcleo del servicio. Un documento completo con todo lo necesario para comunicar con dirección.",
    icon: "lucide:file-text",
    tone: "blue",
    featured: true,
    items: [
      "Diagnóstico de la situación actual",
      "Objetivos de comunicación y prioridades estratégicas",
      "Públicos definidos y mensajes clave",
      "Criterios de estilo y organización de canales",
      "Recomendaciones de trabajo concretas",
    ],
  },
  {
    title: "Mapa de comunicación",
    description:
      "Un esquema visual que muestra qué se comunica, a quién, por qué canal y con qué intención.",
    icon: "lucide:map",
    tone: "purple",
  },
  {
    title: "Base de calendario",
    description:
      "Una hoja de ruta inicial con ejes de contenido, prioridades por etapa y lógica de continuidad.",
    icon: "lucide:calendar-days",
    tone: "green",
  },
  {
    title: "Matriz de roles y responsables",
    description:
      "Un esquema simple que define quién propone, aprueba, ejecuta y da seguimiento.",
    icon: "lucide:users-round",
    tone: "amber",
  },
  {
    title: "Reunión de presentación",
    description:
      "Una videollamada donde se revisa el documento final, se responden preguntas y se explican los pasos para implementar el sistema.",
    icon: "lucide:presentation",
    tone: "blue",
    col2: true,
  },
];

const audiences = [
  "Empresas que sienten que su comunicación está desordenada",
  "Instituciones con varias áreas comunicando al mismo tiempo",
  "Equipos donde todo depende de una sola persona",
  "Profesionales que quieren comunicar con más claridad",
  "Organizaciones que crecieron y necesitan ordenar su comunicación",
];

const results = [
  "Mayor coherencia entre piezas y mensajes",
  "Más claridad al decidir qué comunicar",
  "Menos improvisación, más criterio",
  "Mejor organización interna del equipo",
  "Continuidad real en la comunicación",
];
---

<BaseLayout metadata={metadata}>
  <section class="pc-shell pc-hero">
    <div class="pc-hero-bg" aria-hidden="true">
      <div class="pc-orb pc-orb-a"></div>
      <div class="pc-orb pc-orb-b"></div>
      <div class="pc-grid"></div>
    </div>
    <div class="pc-container pc-hero-grid">
      <div class="reveal active">
        <div class="pc-badge">
          <span class="pc-badge-dot"></span>
          Servicios · Estrategia
        </div>
        <h1 class="pc-hero-title">
          Plan de
          <span>Comunicación</span>
        </h1>
        <p class="pc-hero-copy">
          Ordenamos tu comunicación para que deje de depender de la
          improvisación y empiece a funcionar con una lógica clara y sostenible.
        </p>
        <p class="pc-hero-copy">
          Definimos prioridades, mensajes, canales y responsables para que tu
          organización pueda comunicar con más claridad, coherencia y
          continuidad.
        </p>
        <p class="pc-hero-note">
          No se trata de comunicar más.
          <br />
          Se trata de saber qué comunicar, por qué y cómo sostenerlo en el tiempo.
        </p>
        <div class="pc-hero-actions">
          <Button href="/contacto" size="lg">
            <Icon name="lucide:arrow-right" class="mr-2 h-5 w-5" />
            Quiero ordenar mi comunicación
          </Button>
          <Button href="#proceso" variant="secondary" size="lg">
            <Icon name="lucide:clock-3" class="mr-2 h-5 w-5" />
            Ver cómo trabajamos
          </Button>
        </div>
      </div>
      <div class="pc-hero-visual reveal">
        <div class="pc-doc">
          <div class="pc-doc-header">
            <div class="pc-doc-dots">
              <span class="pc-doc-dot bg-red-400"></span>
              <span class="pc-doc-dot bg-yellow-400"></span>
              <span class="pc-doc-dot bg-green-400"></span>
            </div>
            <div class="pc-doc-title">
              <div class="pc-doc-bar pc-doc-bar-lg"></div>
              <div class="pc-doc-bar pc-doc-bar-sm"></div>
            </div>
          </div>
          <div class="pc-doc-section">
            <div class="pc-doc-accent pc-doc-accent-blue"></div>
            <div class="pc-line w80"></div>
            <div class="pc-line w65"></div>
            <div class="pc-line w90"></div>
            <div class="pc-chip-row">
              <div class="pc-chip"></div>
              <div class="pc-chip purple"></div>
              <div class="pc-chip green"></div>
              <div class="pc-chip"></div>
            </div>
          </div>
          <div class="pc-doc-section">
            <div class="pc-doc-accent pc-doc-accent-purple"></div>
            <div class="pc-line w90"></div>
            <div class="pc-line w50"></div>
            <div class="pc-line w80"></div>
          </div>
          <div class="pc-doc-panels">
            <div class="pc-doc-panel pc-doc-panel-blue">
              <div class="pc-doc-panel-accent"></div>
              <div class="pc-line w80"></div>
              <div class="pc-line w65"></div>
            </div>
            <div class="pc-doc-panel pc-doc-panel-purple">
              <div class="pc-doc-panel-accent"></div>
              <div class="pc-line w80"></div>
              <div class="pc-line w65"></div>
            </div>
          </div>
        </div>
        <div class="pc-float-card pc-float-card-a">
          <div class="pc-float-icon">
            <Icon name="lucide:check-check" class="h-4 w-4" />
          </div>
          <div>
            <div class="pc-float-title">Plan entregado</div>
            <div class="pc-float-copy">Estructura lista para implementar</div>
          </div>
        </div>
        <div class="pc-float-card pc-float-card-b">
          <div class="pc-float-copy">Continuidad</div>
          <div class="pc-float-title">+80%</div>
          <div class="pc-float-bar"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="pc-shell">
    <div class="pc-container">
      <Headline
        tagline="El problema"
        title="Cuando la comunicación depende de la urgencia, todo se vuelve más difícil"
        subtitle="Muchas organizaciones comunican con buena intención, pero sin una estructura clara. Eso genera desorden, sobrecarga en el equipo y decisiones que se toman siempre sobre la marcha."
        classes={{
          container: "mx-auto mb-14 max-w-3xl text-center reveal",
          title:
            "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
          subtitle:
            "mx-auto max-w-2xl text-base leading-8 text-muted-foreground md:text-lg",
        }}
      />
      <div class="pc-grid-3">
        {
          problemCards.map((card, index) => (
            <article
              class={`pc-card pc-problem-card reveal pc-delay-${index + 1}`}
            >
              <div class="pc-problem-icon">
                <Icon name={card.icon} class="h-5 w-5" />
              </div>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))
        }
      </div>
      <div class="pc-problem-note reveal">
        El problema muchas veces no es la falta de ideas, sino la falta de un
        <strong> sistema que ordene la comunicación</strong>.
      </div>
    </div>
  </section>

  <section class="pc-shell pc-band">
    <div class="pc-container pc-two-col">
      <div>
        <Headline
          tagline="Qué hace este servicio"
          title="Transformamos el desorden en una estructura clara de trabajo"
          subtitle="Analizamos cómo está funcionando hoy la comunicación, detectamos lo importante y lo traducimos en una lógica concreta."
          classes={{
            container: "mb-8 max-w-2xl reveal",
            title:
              "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
            subtitle: "text-base leading-8 text-muted-foreground md:text-lg",
          }}
        />
        <div class="pc-check-list">
          {
            whatItems.map((item, index) => (
              <div class={`pc-check-item reveal pc-delay-${index + 1}`}>
                <span class="pc-check">
                  <Icon name="lucide:check" class="h-3.5 w-3.5" />
                </span>
                <span>{item}</span>
              </div>
            ))
          }
        </div>
        <p class="pc-muted-note reveal">
          El objetivo no es llenar de tareas al equipo, sino darle dirección a
          la comunicación.
        </p>
      </div>
      <div class="pc-flow-card reveal">
        <div class="pc-flow-label">Flujo del proceso</div>
        <div class="pc-flow-list">
          {
            flowItems.map((item) => (
              <div class="pc-flow-item">
                <div class={`pc-flow-dot ${item.accent ? "is-accent" : ""}`}>
                  {item.number}
                </div>
                <div class="pc-flow-copy">
                  <h4>{item.title}</h4>
                  <p>{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="pc-shell">
    <div class="pc-container">
      <Headline
        tagline="Qué trabajamos"
        title="Los aspectos clave que hacen que la comunicación funcione"
        subtitle="Este servicio organiza los pilares que permiten que la comunicación sea consistente, sostenible y clara."
        classes={{
          container: "mx-auto mb-14 max-w-3xl text-center reveal",
          title:
            "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
          subtitle:
            "mx-auto max-w-2xl text-base leading-8 text-muted-foreground md:text-lg",
        }}
      />
      <div class="pc-grid-3">
        {
          workCards.map((card, index) => (
            <article
              class={`pc-card pc-work-card reveal pc-delay-${index + 1}`}
              data-tone={card.tone}
            >
              <div class="pc-work-topline">{card.number}</div>
              <div class="pc-work-icon-wrap">
                <Icon name={card.icon} class="h-5 w-5" />
              </div>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <div class="pc-tags">
                {card.tags.map((tag) => (
                  <span class="pc-tag">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pc-shell pc-band" id="proceso">
    <div class="pc-container">
      <Headline
        tagline="Cómo trabajamos"
        title="Un proceso claro, ordenado y fácil de implementar"
        subtitle="Cuatro etapas diseñadas para ir de la situación actual al plan concreto."
        classes={{
          container: "mx-auto mb-14 max-w-3xl text-center reveal",
          title:
            "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
          subtitle:
            "mx-auto max-w-2xl text-base leading-8 text-muted-foreground md:text-lg",
        }}
      />
      <div class="pc-process-grid">
        {
          processSteps.map((step, index) => (
            <article class={`pc-process-step reveal pc-delay-${index + 1}`}>
              <div class={`pc-process-num ${step.accent ? "is-accent" : ""}`}>
                {step.number}
              </div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pc-shell">
    <div class="pc-container">
      <Headline
        tagline="Qué recibís al finalizar"
        title="Un documento claro y utilizable, listo para implementar"
        subtitle="Al terminar el proceso se entrega todo lo necesario para empezar a comunicar con dirección."
        classes={{
          container: "mb-14 max-w-3xl reveal",
          title:
            "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
          subtitle:
            "max-w-2xl text-base leading-8 text-muted-foreground md:text-lg",
        }}
      />
      <div class="pc-deliver-grid">
        {
          deliverCards.map((card, index) => (
            <article
              class={`pc-card pc-deliver-card reveal pc-delay-${index + 1} ${card.featured ? "is-featured" : ""} ${card.col2 ? "is-col2" : ""}`}
            >
              <div class="pc-deliver-head">
                <div class={`pc-deliver-icon pc-tone-${card.tone}`}>
                  <Icon name={card.icon} class="h-5 w-5" />
                </div>
                <h3>{card.title}</h3>
              </div>
              <p>{card.description}</p>
              {card.items && (
                <ul class="pc-deliver-list">
                  {card.items.map((item) => (
                    <li>
                      <span class="pc-check pc-check-sm">
                        <Icon name="lucide:check" class="h-3 w-3" />
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
      <div class="pc-warning reveal">
        <div class="pc-warning-icon">
          <Icon name="lucide:triangle-alert" class="h-5 w-5" />
        </div>
        <p>
          <strong>Qué no incluye este servicio:</strong> este trabajo se enfoca en
          la estrategia y la organización de la comunicación. La producción de piezas,
          diseño, video, motion graphics, campañas o contenidos para redes se trabaja
          dentro del servicio de <strong>Producción Multimedia</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="pc-shell pc-band">
    <div class="pc-container pc-two-col pc-align-start">
      <div>
        <Headline
          tagline="Para quién es"
          title="Este servicio suele ser útil para"
          classes={{
            container: "mb-8 max-w-2xl reveal",
            title:
              "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
          }}
        />
        <div class="pc-audience-list">
          {
            audiences.map((item, index) => (
              <div class={`pc-audience-card reveal pc-delay-${index + 1}`}>
                <span class="pc-audience-dot" />
                <span>{item}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="pc-results-block reveal">
        <div class="pc-flow-label">Qué cambia</div>
        <h3>
          La diferencia no está en comunicar más, sino en comunicar con más
          claridad
        </h3>
        <div class="pc-results-list">
          {
            results.map((item, index) => (
              <div class={`pc-check-item reveal pc-delay-${index + 1}`}>
                <span class="pc-check">
                  <Icon name="lucide:check" class="h-3.5 w-3.5" />
                </span>
                <span>{item}</span>
              </div>
            ))
          }
        </div>
        <p class="pc-muted-note">
          El plan se convierte en una base para sostener el trabajo en el
          tiempo.
        </p>
      </div>
    </div>
  </section>

  <section class="pc-shell pc-cta" id="contacto">
    <div class="pc-cta-bg" aria-hidden="true">
      <div class="pc-orb pc-cta-orb"></div>
    </div>
    <div class="pc-container pc-cta-inner">
      <Headline
        tagline="¿Empezamos?"
        title="Si tu comunicación necesita más orden, claridad y continuidad"
        subtitle="Podemos analizar tu situación y ver si este servicio es un buen punto de partida."
        classes={{
          container: "mx-auto mb-10 max-w-3xl text-center reveal",
          title:
            "font-heading mb-5 text-3xl font-bold tracking-tight text-foreground md:text-5xl",
          subtitle:
            "mx-auto max-w-2xl text-base leading-8 text-muted-foreground md:text-lg",
        }}
      />
      <div class="reveal active">
        <Button href="/contacto" size="lg">
          <Icon name="lucide:arrow-right" class="mr-2 h-5 w-5" />
          Quiero ordenar mi comunicación
        </Button>
      </div>
      <p class="pc-cta-note reveal">
        Sin compromiso. Charlamos primero y vemos si tiene sentido.
      </p>
    </div>
  </section>

  <section class="pc-shell pc-band">
    <div class="pc-container">
      <Headline
        tagline="Preguntas frecuentes"
        title="Preguntas frecuentes sobre plan de comunicación"
        subtitle="Respuestas breves para entender mejor qué incluye este servicio y cómo se trabaja."
