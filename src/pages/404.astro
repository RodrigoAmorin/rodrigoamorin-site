---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/widgets/Hero.astro";

const metadata = {
  title: "404 - Página no encontrada",
  description: "Lo sentimos, no encontramos la página que buscas. Es posible que se haya movido o eliminado.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`<h1 class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent text-[12rem] font-extrabold tracking-tighter mb-4">404</h1>`}
    description="Lo sentimos, no encontramos la página que buscas. Es posible que se haya movido o eliminado."
    actions={[
      {
        variant: "primary",
        text: "Volver al inicio",
        href: "/",
        icon: "lucide:home",
      },
      {
        variant: "secondary",
        text: "Contactar",
        href: "/contacto",
        icon: "lucide:phone",
      },
    ]}
  />
</BaseLayout>
