---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceList from "../components/widgets/ServiceList.astro";
import Content from "../components/widgets/Content.astro";
import Content2 from "../components/widgets/Content2.astro";
import webDevImg from "../assets/images/services/web-dev.webp"; 
import seoImg from "../assets/images/services/seo.webp";
import consultingImg from "../assets/images/services/consulting.webp";

import planComImg from "../assets/images/services/plan-de-comunicacion.webp";
import produccionImg from "../assets/images/services/Diseno-multimedia.webp";
import iaImg from "../assets/images/services/automatizacion-ia.webp";


const services = [
  {
    title: "Plan de comunicación",
    description:
      "Armamos un plan claro para que la comunicación no dependa de una sola persona y el equipo pueda sostenerla.",
    icon: "lucide:clipboard-list",
    href: "#plan-de-comunicacion",
  },
  {
    title: "Producción multimedia",
    description:
      "Diseño, video y motion para campañas, institucional, redes y streaming. Piezas listas para publicar y reutilizar.",
    icon: "lucide:film",
    href: "#produccion-multimedia",
  },
  {
    title: "Automatización e IA",
    description:
      "Automatizamos tareas repetitivas y ordenamos flujos internos: menos caos, menos errores, más tiempo para lo importante.",
    icon: "lucide:zap",
    href: "#automatizacion-ia",
  },
];

const metadata = {
  title: "Servicios | Comunicación, multimedia y automatización",
  description:
    "Planes de comunicación, producción multimedia y automatización con IA para empresas e instituciones. Soluciones claras, aplicables y sostenibles.",
};
---

<BaseLayout {metadata}>
  <!-- HERO -->
  <Content
    tagline="Servicios"
    title="Nuestros servicios"
    description={[
      "Soluciones pensadas para empresas e instituciones que necesitan comunicar mejor, producir contenido de forma consistente y ordenar procesos con tecnología.",
    ]}
    classes={{ container: "pb-0 md:pb-0" }}
  />

  <!-- CARDS -->
  <ServiceList services={services} classes={{ container: "pt-6 md:pt-6" }} />

  <!-- SERVICIO 1 -->
  <Content
    id="plan-de-comunicacion"
    tagline="Estrategia y organización"
    title="Plan de comunicación"
    description={[
      "Cuando todo pasa por una sola persona, la comunicación se vuelve irregular, reactiva y difícil de sostener.",
      "Acá el objetivo es simple: definir qué se comunica, para quién, por dónde y con qué prioridades. Y dejarlo funcionando con un método que el equipo pueda seguir.",
    ]}
    classes={{ container: "pb-0 md:pb-0" }}
  />

  <Content2
    items={[
      {
        title: "Prioridades y calendario",
        description:
          "Definimos focos por mes y armamos una hoja de ruta realista para que no se improvisen temas todas las semanas.",
      },
      {
        title: "Mensajes y tono",
        description:
          "Alineamos lo que se quiere decir con cómo se dice: mensajes clave, criterios de estilo y coherencia entre áreas.",
      },
      {
        title: "Organización del equipo",
        description:
          "Roles, responsables y un tablero simple para que el seguimiento no dependa de la memoria de alguien.",
      },
    ]}
    image={planComImg}
    imageAlt="Plan de comunicación"
    classes={{ container: "pt-0 md:pt-0" }}
  >
    <div>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Comunicación bien ordenada
      </h3>
      <p class="text-muted-foreground">
        Desarrollamos un plan claro para organizar la comunicación de tu empresa o institución:
prioridades, canales, mensajes y responsables. El objetivo es que la comunicación tenga dirección
y continuidad, sin depender de decisiones improvisadas.
      </p>
    </div>
  </Content2>

  <!-- SERVICIO 2 -->
  <Content
    id="produccion-multimedia"
    tagline="Diseño, video y motion"
    title="Producción multimedia"
    description={[
      "Diseño, video y motion para comunicar con claridad en cualquier canal: redes, campañas, institucional, streaming o eventos.",
      "La clave es producir con criterio y con formatos reutilizables, para que no sea todo “una pieza nueva desde cero” cada vez.",
    ]}
    classes={{ container: "pb-0 md:pb-0" }}
  />

  <Content2
    isReversed={true}
    items={[
      {
        title: "Diseño gráfico y piezas de campaña",
        description:
          "Placas, banners, carruseles, adaptaciones por formato y material para pauta o difusión interna.",
      },
      {
        title: "Video y motion",
        description:
          "Reels, institucionales, animaciones, zócalos y packs para comunicación en vivo (streaming).",
      },
      {
        title: "Sistema de formatos",
        description:
          "Armamos plantillas y criterios para que la comunicación se vea coherente aunque la produzcan varias personas.",
      },
    ]}
    image={produccionImg}
    imageAlt="Producción multimedia"
  >
    <div>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
       Producción audiovisual y gráfica
      </h3>
      <p class="text-muted-foreground">
        Diseño gráfico, video, motion y piezas digitales para campañas,
comunicación institucional, redes, eventos o streaming.
Cada proyecto se desarrolla con estructura, guion y criterios visuales definidos.
      </p>
    </div>
  </Content2>

  <!-- SERVICIO 3 -->
  <Content
    id="automatizacion-ia"
    tagline="Procesos, IA y sistemas digitales"
    title="Automatización e Inteligencia Artificial"
    description={[
      "Automatizamos tareas repetitivas y ordenamos procesos internos para ahorrar tiempo y reducir errores.",
      "Se aplica según cada caso: consultas, formularios, seguimiento, contenidos, documentación y flujos de trabajo.",
    ]}
    classes={{ container: "pb-0 md:pb-0" }}
  />

  <Content2
    items={[
      {
        title: "Formularios y flujos",
        description:
          "Estandarizamos ingresos de datos y los llevamos a un sistema usable (Sheets/Drive/Notion/Trello).",
      },
      {
        title: "Seguimientos automáticos",
        description:
          "Recordatorios, respuestas, derivaciones y alertas para que los procesos no dependan de perseguir gente.",
      },
      {
        title: "IA para acelerar trabajo",
        description:
          "Asistencia para redacción, clasificación, borradores y organización de información, cuidando el tono institucional.",
      },
    ]}
    image={iaImg}
    imageAlt="Automatización e IA"
  >
    <div>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Optimización de procesos y flujos de trabajo
      </h3>
      <p class="text-muted-foreground">
        Implementamos automatizaciones y herramientas de inteligencia artificial
para ordenar procesos internos, optimizar tiempos y reducir tareas repetitivas.
Las soluciones se adaptan a la estructura y necesidades de cada organización.
      </p>
    </div>
  </Content2>
</BaseLayout>