---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Schema from "../../components/seo/Schema.astro";
import PostItem from "../../components/blog/PostItem.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const blog = await getCollection("blog");

  return blog.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, pubDate, author, image, category, tags } = post.data;

const slugify = (str: string) =>
  str
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const formattedDate = pubDate.toLocaleDateString("es-AR", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/Argentina/Buenos_Aires",
});

const readingTime = remarkPluginFrontmatter?.minutesRead
  ? `${Math.ceil(remarkPluginFrontmatter.minutesRead)} min de lectura`
  : "";

const metadata = {
  title,
  description,
  ogImage: image,
};

// Mapa de categorías -> páginas pilar
const categoryLinks: Record<string, string> = {
  "Producción audiovisual": "/produccion-audiovisual",
  "Plan de comunicación": "/plan-comunicacion",
  "Automatización e IA": "/automatizacion-ia",
};

const categoryHref = category
  ? categoryLinks[category] || `/blog/category/${slugify(category)}`
  : "/blog";

const backLabel = category ? `Volver a ${category}` : "Volver al blog";

// Posts relacionados de la misma categoría
const allPosts = await getCollection("blog");

const relatedPosts = allPosts
  .filter(
    (item) =>
      item.id !== post.id &&
      item.data?.pubDate &&
      item.data.category === category
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout metadata={metadata}>
  <Schema
    type="BlogPosting"
    data={{
      title,
      description,
      image,
      pubDate,
      author,
      url: Astro.url.href,
    }}
  />

  <section class="relative px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="relative mx-auto max-w-3xl">
      <div class="mb-10 text-center">
        <nav class="mb-4 flex flex-wrap items-center justify-center gap-2 text-sm text-muted-foreground">
          <a href="/" class="transition-colors duration-200 hover:text-foreground">
            Inicio
          </a>
          <span aria-hidden="true">/</span>

          {category ? (
            <>
              <a
                href={categoryHref}
                class="transition-colors duration-200 hover:text-foreground"
              >
                {category}
              </a>
              <span aria-hidden="true">/</span>
            </>
          ) : (
            <>
              <a
                href="/blog"
                class="transition-colors duration-200 hover:text-foreground"
              >
                Blog
              </a>
              <span aria-hidden="true">/</span>
            </>
          )}

          <span class="text-foreground">{title}</span>
        </nav>

        <p class="text-sm font-semibold tracking-wide text-primary uppercase">
          {formattedDate} • {author}
          {readingTime && ` • ${readingTime}`}
        </p>

        <div class="mt-4 flex flex-wrap justify-center gap-2">
          {category && (
            <a
              href={categoryHref}
              class="inline-flex items-center rounded-full border border-border bg-primary/15 px-3 py-1 text-xs font-semibold text-primary transition-colors duration-200 hover:bg-primary/20"
            >
              {category}
            </a>
          )}

          {tags?.map((tag) => (
            <a
              href={`/blog/tags/${slugify(tag)}`}
              class="inline-flex items-center rounded-full border border-border bg-muted/40 px-3 py-1 text-xs font-medium text-muted-foreground transition-colors duration-200 hover:bg-muted hover:text-foreground"
            >
              {tag}
            </a>
          ))}
        </div>

        <h1
          class="font-heading mt-2 text-3xl font-bold leading-tight tracking-tighter text-foreground sm:text-4xl md:text-5xl"
        >
          {title}
        </h1>
      </div>

      {
        image && (
          <div class="relative mb-8 h-96 w-full overflow-hidden rounded-xl shadow-lg">
            <img src={image} alt={title} class="h-full w-full object-cover" />
          </div>
        )
      }

      <div
        class="prose prose-lg dark:prose-invert mx-auto prose-headings:text-foreground prose-a:text-primary hover:prose-a:underline prose-p:text-muted-foreground prose-strong:text-foreground prose-li:text-muted-foreground prose-code:text-primary"
      >
        <Content />

        <div class="mt-10 mb-8 text-center">
          <a
            href={categoryHref}
            class="inline-flex items-center gap-2 text-primary no-underline hover:text-primary/80"
          >
            <span aria-hidden="true">←</span>
            <span class="font-medium">{backLabel}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="relative px-4 pb-12 sm:px-6 lg:px-8 md:pb-16">
      <div class="mx-auto max-w-5xl">
        <div class="mb-8 text-center">
          <p class="text-sm font-semibold tracking-wide text-primary uppercase">
            Seguí explorando
          </p>
          <h2 class="font-heading mt-2 text-3xl font-bold tracking-tight text-foreground md:text-4xl">
            También te puede interesar
          </h2>
          {category && (
            <p class="mt-3 text-muted-foreground">
              Más artículos relacionados con {category.toLowerCase()}.
            </p>
          )}
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((relatedPost) => (
            <PostItem post={relatedPost} />
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href={categoryHref}
            class="inline-flex items-center gap-2 text-primary no-underline hover:text-primary/80"
          >
            <span class="font-medium">Ver más sobre {category}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>