---
import Button from "./Button.astro";

interface Props {
  successUrl?: string; // a dónde redirige al enviar
  formName?: string;   // nombre del form para Netlify
}

const { successUrl = "/gracias/", formName = "contacto" } = Astro.props;
---

<form
  name={formName}
  method="POST"
  action={successUrl}
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-6"
>
  <!-- Obligatorio para que Netlify identifique el formulario -->
  <input type="hidden" name="form-name" value={formName} />

  <!-- Campo trampa anti-spam (no se ve) -->
  <p class="hidden">
    <label>
      No completar:
      <input name="bot-field" />
    </label>
  </p>

  <div>
    <label for="name" class="block text-sm font-medium text-foreground/80 mb-2">
      Nombre
    </label>
    <input
      type="text"
      name="name"
      id="name"
      autocomplete="name"
      required
      class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
      placeholder="Tu nombre"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-foreground/80 mb-2">
      Email
    </label>
    <input
      type="email"
      name="email"
      id="email"
      autocomplete="email"
      required
      class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
      placeholder="tu@email.com"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-foreground/80 mb-2">
      Mensaje
    </label>
    <textarea
      name="message"
      id="message"
      rows="4"
      required
      class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4 resize-none"
      placeholder="¿En qué te puedo ayudar?"></textarea>
  </div>

  <div>
    <Button type="submit" size="lg" class="w-full sm:w-auto">
      Enviar mensaje
    </Button>
  </div>

  <p class="text-xs text-muted-foreground">
    Respondemos dentro de 24 horas hábiles.
  </p>
</form>