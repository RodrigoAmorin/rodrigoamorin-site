---
import WidgetWrapper from "./WidgetWrapper.astro";
import Headline from "../ui/Headline.astro";
import Card from "../ui/Card.astro";

import work1 from "../../assets/images/work/work1.webp";
import work2 from "../../assets/images/work/work2.webp";
import work3 from "../../assets/images/work/work3.webp";

interface Work {
  title: string;
  description: string;
  tags: string[];
  image: ImageMetadata;
  href: string;
}

interface Props {
  id?: string;
  isDark?: boolean;
  classes?: Record<string, string>;
  bg?: string;

  tagline?: string;
  title?: string;
  subtitle?: string;

  ctaLabel?: string;
  ctaHref?: string;

  works?: Work[];
}

const {
  id = "trabajos",
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),

  tagline = "Trabajos seleccionados",
  title = "Historias que acompañamos",
  subtitle = "Una selección de piezas y sistemas visuales aplicados a comunicación y campañas.",

  ctaLabel = "Ver más casos →",
  ctaHref = "/portfolio",

  works = [
    {
      title: "Campaña digital para marca local",
      description: "Producción de piezas y sistema visual para redes sociales.",
      tags: ["Motion", "Social Media"],
      image: work1,
      href: "/casos/campana-digital-marca-local",
    },
    {
      title: "Video institucional para evento",
      description: "Video principal para comunicación institucional.",
      tags: ["Edición", "Storytelling"],
      image: work2,
      href: "/casos/video-institucional-evento",
    },
    {
      title: "Sistema visual para contenidos",
      description: "Plantillas reutilizables para contenido digital.",
      tags: ["Branding", "Motion"],
      image: work3,
      href: "/casos/sistema-visual-contenidos",
    },
  ],
} = Astro.props as Props;

const { container: containerClassProp = "", ...otherClasses } = classes;

// por si algún día te mandan más de 3, home siempre muestra 3
const visible = works.slice(0, 3);
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  bg={bg}
  classes={otherClasses}
  containerClass={` ${containerClassProp}`}
>
  <section class="mx-auto max-w-6xl">
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: "max-w-3xl mx-auto text-center mb-10 md:mb-12",
      }}
    />

    <div class="grid">
      {visible.map((w) => (
        <Card href={w.href} class="workCard" aria-label={`Ver caso: ${w.title}`}>
          <div class="media">
            <img
              src={w.image.src}
              width={w.image.width}
              height={w.image.height}
              alt={w.title}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="body">
            <div class="top">
              <h3 class="title">{w.title}</h3>
              <p class="desc">{w.description}</p>
            </div>

            <div class="bottom">
              <div class="tags" aria-label="Etiquetas">
                {w.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

             <span class="hint">
  Ver caso
  <svg class="hintIcon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 17L17 7M10 7h7v7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</span>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <div class="cta">
      <a class="ctaLink" href={ctaHref}>{ctaLabel}</a>
    </div>
  </section>
</WidgetWrapper>

<style>
    
  .grid{
    display:grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @media (min-width: 768px){
    .grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Card base: la tuya ya trae bg-card + border + shadow.
     Acá sumamos layout “vertical pro” + hover sutil */
  :global(a.workCard){
    padding: 0;                 /* pisamos el p-8 del Card base */
    overflow: hidden;
    display:flex;
    flex-direction: column;
    border-radius: 18px;
    transform: translateY(0);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    position: relative; /* clave para el ::before */
}
:global(a.workCard)::before{
  content:"";
  position:absolute;
  inset:0;
  border-radius:18px;
  pointer-events:none;

  /* borde interno sutil (se nota sin gritar) */
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);
  opacity:.9;
}

  :global(a.workCard:hover){
    transform: translateY(-3px);
    box-shadow: 0 18px 55px rgba(0,0,0,.22);
  }
  :global(:root[data-theme="dark"]) :global(a.workCard)::before{
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
}

  .media{
    aspect-ratio: 16/9;
    background: hsl(var(--muted));
    overflow:hidden;
  }

  .media img{
    width:100%;
    height:100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform .35s ease;
    display:block;
  }

  :global(a.workCard:hover) .media img{
    transform: scale(1.03);
  }

  .body{
    padding: 16px 18px 16px;
    display:flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .top{
    display:flex;
    flex-direction: column;
    gap: 8px;
  }

.title{
  font-size:16px;
  font-weight:600;
  line-height:1.35;
  letter-spacing:-0.01em;
}

  .desc{
    font-size: 14px;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
    margin: 0;

    /* Para que no te rompa alturas */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Empuja tags + hint abajo siempre */
  .bottom{
    margin-top: auto;
    display:flex;
    flex-direction: column;
    gap: 10px;
  }

 .tags{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:6px;
}

.tag{
  font-size:11px;
  padding:5px 11px;
  border-radius:999px;

  border:1px solid rgba(255,255,255,0.12);
  background:rgba(255,255,255,0.03);

  color:hsl(var(--muted-foreground));

  transition:
    border-color .2s ease,
    background .2s ease,
    transform .15s ease;

  cursor:pointer;
}
.tag:hover{
  border-color:hsl(var(--primary));
  background:rgba(255,255,255,0.06);
  transform:translateY(-1px);
}

.hint{
  font-weight:500;
  font-size:13px;
  color:hsl(var(--foreground));
  display:flex;
  align-items:center;
  gap:8px;
  opacity:.75;
  transition:opacity .2s ease, transform .2s ease;
}

.hintIcon{
  width:14px;
  height:14px;
  opacity:.85;
  transition:transform .2s ease, opacity .2s ease;
}

:global(a.workCard:hover) .hint{
  opacity:1;
  transform:translateX(3px);
}

:global(a.workCard:hover) .hintIcon{
  opacity:1;
  transform:translate(2px,-2px);
}

  .cta{
    margin-top: 26px;
    text-align:center;
  }

  .ctaLink{
  font-weight:500;
  font-size:14px;
  color:hsl(var(--foreground));
  opacity:.8;

  transition:opacity .2s ease, transform .2s ease;
}

.ctaLink:hover{
  opacity:1;
  transform:translateX(3px);
}


</style>