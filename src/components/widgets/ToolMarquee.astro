---
import WidgetWrapper from "./WidgetWrapper.astro";

interface Props {
  speedSeconds?: number;
  dense?: boolean;
  id?: string;
  isDark?: boolean;
  classes?: Record<string, string>;
  bg?: string;
  repeatSets?: 2 | 3 | 4 | 5;
}

const {
  speedSeconds = 26,
  dense = false,
  id = "stack",
  isDark = false,
  classes = {},
  repeatSets = 4,
  bg = await Astro.slots.render("bg"),
} = Astro.props as Props;

const toolSvgs = import.meta.glob("/src/assets/images/herramientas/*.svg", {
  eager: true,
  as: "url",
});

const tools = (Object.values(toolSvgs) as string[]).sort((a, b) =>
  a.localeCompare(b, "en"),
);

const mid = Math.ceil(tools.length / 2);
const rowA = tools.slice(0, mid);
const rowB = tools.slice(mid);

const repeat = (arr: string[], times: number) =>
  Array.from({ length: times }, () => arr).flat();

const rowARep = repeat(rowA, repeatSets);
const rowBRep = repeat(rowB, repeatSets);
const shiftPercent = -(100 / repeatSets);
---

<WidgetWrapper id={id} isDark={isDark} bg={bg} classes={classes} animate={false}>
  <section class="mx-auto max-w-6xl">
    <div class="wrap" style={`--dur:${speedSeconds}s; --shift:${shiftPercent}%;`}>
      <div class={`row ${dense ? "dense" : ""}`} aria-label="Herramientas y software que usamos">
        <div class="track" role="list">
          {rowARep.map((src) => (
            <div class="logo" role="listitem">
              <img src={src} alt="" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>

      {rowB.length > 0 && (
        <div class={`row reverse ${dense ? "dense" : ""}`} aria-label="Herramientas y software que usamos">
          <div class="track" role="list">
            {rowBRep.map((src) => (
              <div class="logo" role="listitem">
                <img src={src} alt="" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</WidgetWrapper>

<style>
  .wrap {
    display: grid;
    gap: 16px;
    padding: 6px 0 18px;
  }

  .row {
    position: relative;
    overflow: hidden;
    padding: 8px 0;
  }

  .track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 14px;
    will-change: transform;
    animation: scroll var(--dur) linear infinite;
  }

  .reverse .track {
    animation-direction: reverse;
  }

  .row:hover .track {
    animation-play-state: paused;
  }

  .logo {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    flex: 0 0 auto;
    background: hsl(var(--card) / 0.55);
    border: 1px solid hsl(var(--border) / 0.7);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .dense .logo {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    padding: 9px;
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    opacity: 0.92;
    filter: grayscale(1) brightness(1.25);
    transition:
      transform 0.25s ease,
      filter 0.25s ease,
      opacity 0.25s ease;
  }

  .logo:hover img {
    opacity: 1;
    filter: none;
    transform: translateY(-1px);
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .logo {
      width: 56px;
      height: 56px;
      border-radius: 16px;
    }

    .track {
      gap: 12px;
    }

    .row {
      padding: 8px 0;
    }
  }
</style>
